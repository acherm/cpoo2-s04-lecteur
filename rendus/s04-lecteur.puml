@startuml
title Mon lecteur de parties

class LecteurDeParties {
  +resume() : String
}
class Scenario <<record>> {
  +parcourir(v : VisiteurDeScenario)
}
interface Instruction {
  +accept(v : VisiteurDeScenario)
}
class Pousser <<record>> {
  equipe : Couleur
  de : Position
  vers : Position
  +enCoup() : Coup
}

LecteurDeParties --> Scenario : fichier
Scenario o-- "*" Instruction
Instruction <|.. Pousser
@enduml
